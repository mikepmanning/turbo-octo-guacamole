# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recipehome
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# JPA/Hibernate Configuration
# Options: create, create-drop, update, validate, none
# Use 'update' for development, 'validate' for production
HIBERNATE_DDL_AUTO=update

# Logging
# Options: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL_APP=INFO
LOG_LEVEL_ALEXA=DEBUG
LOG_LEVEL_SQL=DEBUG
LOG_FILE_PATH=logs/recipehome.log

# Alexa Configuration
ALEXA_SKILL_ID=amzn1.ask.skill.your-skill-id-here
