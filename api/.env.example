# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recipehome
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# JPA/Hibernate Configuration
# Flyway migrations (src/main/resources/db/migration) own the schema; Hibernate only checks the
# entities against it. Keep this on validate: update would change tables behind Flyway's back.
HIBERNATE_DDL_AUTO=validate

# Sample Data
# Options: true, false (default: true)
# Loads 86 sample recipes into an empty database at startup. Set to false for production.
SEED_DATA=true

# Login tokens
# Secret that signs login tokens: at least 32 random characters (e.g. `openssl rand -base64 48`).
# Leave empty in development to use a random key per run (users log in again after a restart).
JWT_SECRET=
# How long a login lasts (e.g. 7d, 12h)
JWT_EXPIRATION=7d

# Logging
# Options: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL_APP=INFO
LOG_LEVEL_ALEXA=DEBUG
LOG_LEVEL_SQL=DEBUG
LOG_FILE_PATH=logs/recipehome.log

# Alexa Configuration
ALEXA_SKILL_ID=amzn1.ask.skill.your-skill-id-here
